{
  "name": "data-pipeline-monitor",
  "version": "0.1.0",
  "description": "Read-only cross-platform data pipeline monitoring UI",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "format": "prettier --write src tests index.html package.json tsconfig.json vite.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msrinu89/data-pipeline-monitor.git"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "bugs": {
    "url": "https://github.com/msrinu89/data-pipeline-monitor/issues"
  },
  "homepage": "https://github.com/msrinu89/data-pipeline-monitor#readme",
  "dependencies": {
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "private": true
}
